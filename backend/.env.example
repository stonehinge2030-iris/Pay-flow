# Stripe keys — from https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_..., pk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# A long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Where the frontend runs, for Stripe Connect onboarding redirects and CORS
FRONTEND_URL=http://localhost:5173

# Port for this server
PORT=4000
