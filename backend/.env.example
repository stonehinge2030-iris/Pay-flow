# Stripe keys — from https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_..., pk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# A long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Where the frontend runs, for Stripe Connect onboarding redirects, CORS,
# and the links inside verification emails
FRONTEND_URL=http://localhost:5173

# From https://resend.com/api-keys — used to send verification emails.
# If left blank, signup still works, it just skips sending the email
# (the link gets logged to the console instead, for local testing).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional: only needed once you've verified your own sending domain in
# Resend. Until then, leave unset and it defaults to onboarding@resend.dev.
# EMAIL_FROM=PayFlow <hello@yourdomain.com>

# Port for this server
PORT=4000
